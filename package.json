{
  "name": "toyland-integrated",
  "private": true,
  "version": "1.0.0",
  "description": "ToyStore — monorepo root. Backend + three independent frontend apps.",
  "type": "module",
  "scripts": {
    "dev:backend": "node backend/server.js",
    "dev:customer": "npm --prefix frontend/customer run dev",
    "dev:admin":    "npm --prefix frontend/admin run dev",
    "dev:seller":   "npm --prefix frontend/seller run dev",
    "dev:all":      "concurrently \"npm run dev:backend\" \"npm run dev:customer\" \"npm run dev:admin\" \"npm run dev:seller\"",
    "dev":          "npm run dev:all",
    "server":       "node backend/server.js",
    "build:customer": "npm --prefix frontend/customer run build",
    "build:admin":    "npm --prefix frontend/admin run build",
    "build:seller":   "npm --prefix frontend/seller run build",
    "build:all":      "npm run build:customer && npm run build:admin && npm run build:seller"
  },
  "dependencies": {
    "bcrypt":      "^6.0.0",
    "cors":        "^2.8.6",
    "dotenv":      "^17.4.0",
    "express":     "^5.2.1",
    "jsonwebtoken":"^9.0.3",
    "multer":      "^2.1.1",
    "nodemailer":  "^8.0.5",
    "nodemon":     "^3.1.14",
    "pg":          "^8.20.0",
    "socket.io":   "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
